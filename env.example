# Copy to .env.local (never commit it) to connect the assistant to Claude.
# Without a key the assistant still works through its built-in planner.
ANTHROPIC_API_KEY=
# Optional. Default: claude-sonnet-5-5. Use claude-opus-5-5 for the most capable model.
AGENT_MODEL=
# Optional. A gateway or proxy in place of https://api.anthropic.com
ANTHROPIC_BASE_URL=
# Optional. Where vouchers and bonuses are stored. Default: data/unijourney.json
UNIJOURNEY_DATA=
# Optional. The UniJourney API to proxy to.
UNIJOURNEY_API=https://unijourney-yu-a12fda.fly.dev
